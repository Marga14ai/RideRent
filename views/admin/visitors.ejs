<%- include('../partials/header') %><section class="section"><div class="container"><h1>Visitor statistics</h1><p>Visitors count browser sessions; page views count public page loads, including refreshes. Counts started after this update and may include bots. No GPS or IP address is stored.</p><div class="stat-grid"><div class="stat-card">Visitor sessions<strong><%= stats.visitors %></strong></div><div class="stat-card">Page views<strong><%= stats.views %></strong></div><div class="stat-card">Views today (UTC)<strong><%= stats.today||0 %></strong></div></div><div class="table-wrap"><table><thead><tr><th>Page</th><th>Views</th><th>Visitor sessions</th></tr></thead><tbody><% pages.forEach(p=>{ %><tr><td><%= p.path %></td><td><%= p.views %></td><td><%= p.visitors %></td></tr><% }) %></tbody></table></div></div></section><%- include('../partials/footer') %>