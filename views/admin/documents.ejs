<%- include('../partials/header') %><section class="section"><div class="container"><h1>Motorcycle registration</h1><p>Renewal reminders appear one calendar month before expiry while the server is running, or at its next startup. Upload actual documents for every existing motorcycle.</p><div class="table-wrap"><table><thead><tr><th>Motorcycle</th><th>Plate</th><th>OR</th><th>CR</th><th>Valid until</th><th>Status</th><th>Action</th></tr></thead><tbody><% vehicles.forEach(v=>{const today=new Date().toISOString().slice(0,10); %><tr><td><%= v.brand %> <%= v.model %></td><td><%= v.plate_number %></td><td><% if(v.or_path){ %><a href="<%= v.or_path %>">View OR</a><% }else{ %>Missing<% } %></td><td><% if(v.cr_path){ %><a href="<%= v.cr_path %>">View CR</a><% }else{ %>Missing<% } %></td><td><%= v.registration_expiry||'Not set' %></td><td><%= !v.or_path||!v.cr_path||!v.registration_expiry?'Needs documents':v.registration_expiry<today?'Expired':v.registration_expiry<=new Date(Date.now()+31*86400000).toISOString().slice(0,10)?'Renew soon':'Current' %></td><td><a href="/admin/vehicles/<%= v.id %>/edit">Update</a></td></tr><% }) %></tbody></table></div></div></section><%- include('../partials/footer') %>