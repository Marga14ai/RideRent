<%- include('../partials/header') %><section class="dashboard-shell"><div class="container"><div class="dash-head"><div><span class="eyebrow">Operations</span><h1>Booking Management</h1></div></div><div class="table-wrap"><table><thead><tr><th>Booking</th><th>Customer</th><th>Vehicle</th><th>Dates</th><th>Payment</th><th>Status</th><th></th></tr></thead><tbody><% bookings.forEach(b=>{ %><tr><td><strong><%= b.booking_code %></strong></td><td><%= b.first_name %> <%= b.last_name %></td><td><%= b.brand %> <%= b.model %></td><td><%= b.start_date %> → <%= b.end_date %></td><td><span class="status"><%= b.payment_status %></span></td><td><span class="status"><%= b.booking_status %></span></td><td><a href="/admin/bookings/<%= b.id %>">Manage</a></td></tr><% }) %></tbody></table></div></div></section><%- include('../partials/footer') %>
