<%- include('../partials/header') %><section class="section"><div class="container narrow"><div class="panel"><span class="eyebrow">Fleet management</span><h1><%= vehicle?'Edit vehicle':'Add vehicle' %></h1><form method="post" action="<%= vehicle?'/admin/vehicles/'+vehicle.id:'/admin/vehicles' %>" class="form-grid" enctype="multipart/form-data"><label>Type<select name="type" required><option <%= vehicle?.type==='Car'?'selected':'' %>>Car</option><option <%= vehicle?.type==='Motorcycle'?'selected':'' %>>Motorcycle</option></select></label><label>Brand<input name="brand" value="<%= vehicle?.brand||'' %>" required></label><label>Model<input name="model" value="<%= vehicle?.model||'' %>" required></label><label>Year<input type="number" name="year" value="<%= vehicle?.year||'' %>"></label><label>Plate number<input name="plate_number" value="<%= vehicle?.plate_number||'' %>" required></label><label>Color<input name="color" value="<%= vehicle?.color||'' %>"></label><label>Transmission<select name="transmission"><option <%= vehicle?.transmission==='Automatic'?'selected':'' %>>Automatic</option><option <%= vehicle?.transmission==='Manual'?'selected':'' %>>Manual</option></select></label><label>Fuel type<select name="fuel_type"><option <%= vehicle?.fuel_type==='Gasoline'?'selected':'' %>>Gasoline</option><option <%= vehicle?.fuel_type==='Diesel'?'selected':'' %>>Diesel</option></select></label><label>Seats<input type="number" name="seats" value="<%= vehicle?.seats||'' %>"></label><label>Engine CC<input type="number" name="engine_cc" value="<%= vehicle?.engine_cc||'' %>"></label><label>Daily rate<input type="number" step="0.01" name="daily_rate" value="<%= vehicle?.daily_rate||'' %>" required></label><label>Status<select name="status"><% ['Available','Reserved','Rented','Maintenance','Unavailable','Archived'].forEach(s=>{ %><option <%= vehicle?.status===s?'selected':'' %>><%= s %></option><% }) %></select></label><div class="full terms-box">Motorcycles require genuine OR and CR documents. Existing uploads stay when no replacement is selected. Maximum 5 MB per file.</div><label>Official Receipt (OR)<input type="file" name="or_file" accept=".pdf,.jpg,.jpeg,.png,.webp"><% if(vehicle?.or_path){ %><a href="<%= vehicle.or_path %>" target="_blank">View current OR</a><% } %></label><label>Certificate of Registration (CR)<input type="file" name="cr_file" accept=".pdf,.jpg,.jpeg,.png,.webp"><% if(vehicle?.cr_path){ %><a href="<%= vehicle.cr_path %>" target="_blank">View current CR</a><% } %></label><label class="full">Registration valid until<input type="date" name="registration_expiry" value="<%= vehicle?.registration_expiry||'' %>"></label><label class="full">Image path<input name="image" value="<%= vehicle?.image||'' %>" placeholder="/images/car.svg"></label><label class="full">Description<textarea name="description"><%= vehicle?.description||'' %></textarea></label><label class="full check"><input type="checkbox" name="helmet_included" <%= vehicle?.helmet_included?'checked':'' %>> Helmet included (motorcycle)</label><div class="full"><button class="btn btn-primary">Save vehicle</button> <a class="btn btn-light" href="/admin/vehicles">Cancel</a></div></form></div></div></section><%- include('../partials/footer') %>
