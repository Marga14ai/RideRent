<%- include('../partials/header') %><section class="section"><div class="container"><div class="dash-head"><div><span class="eyebrow">Booking details</span><h1><%= booking.booking_code %></h1></div><button type="button" class="btn btn-light" onclick="document.getElementById('receipt-preview').classList.add('open')">View receipt</button></div><div class="detail-panels"><section class="panel"><h2><%= booking.brand %> <%= booking.model %></h2><p><strong>Dates:</strong> <%= booking.start_date %> <%= booking.pickup_time %> → <%= booking.end_date %> <%= booking.return_time %></p><p><strong>Status:</strong> <%= booking.booking_status %></p><p><strong>Payment:</strong> <%= booking.payment_status %> • <%= booking.payment_option %></p><p><strong>Total:</strong> ₱<%= Number(booking.total_amount).toLocaleString() %></p><p><strong>Paid:</strong> ₱<%= Number(booking.amount_paid).toLocaleString() %></p><p><strong>Late fee:</strong> ₱<%= Number(booking.late_penalty).toLocaleString() %></p><p><strong>Balance:</strong> ₱<%= Math.max(0,booking.total_amount+booking.late_penalty-booking.amount_paid).toLocaleString() %></p><% if(booking.refund_status && booking.refund_status!=='None'){ %><p><strong>Refund:</strong> <%= booking.refund_status %></p><% } %></section><section class="panel"><h2>Actions</h2><% if(booking.booking_status==='Confirmed'){ %><form method="post" action="/customer/bookings/<%= booking.id %>/cancel" class="form-stack" data-confirm="Cancel this booking?"><label>Cancellation reason<input name="reason" placeholder="Optional"></label><button class="btn btn-danger" data-confirm="Cancel this booking?">Cancel booking</button></form><hr><form method="post" action="/customer/bookings/<%= booking.id %>/extend" class="form-stack"><label>Extend return date<input type="date" name="new_end_date" required></label><button class="btn btn-light">Request extension</button></form><% } else if(booking.booking_status==='Ongoing'){ %><form method="post" action="/customer/bookings/<%= booking.id %>/extend" class="form-stack"><label>Extend return date<input type="date" name="new_end_date" required></label><button class="btn btn-light">Request extension</button></form><% } %><% if(booking.payment_method==='Pay at Location' && booking.booking_status!=='Cancelled' && Number(booking.amount_paid)<Number(booking.total_amount)+Number(booking.late_penalty)){ %><hr><p>Pay the remaining balance at the pickup shop. Shop staff will record the amount received, and your payment status and receipt will update.</p><% } %><% if(booking.payment_method==='Online Transfer' && ['Unpaid','Rejected','Partially Paid'].includes(booking.payment_status) && booking.booking_status!=='Cancelled'){ %><hr><form method="post" action="/customer/bookings/<%= booking.id %>/payment" enctype="multipart/form-data" class="form-stack"><h3>Submit payment proof</h3><label>Amount<input type="number" step="0.01" name="amount" required></label><label>Reference no.<input name="reference_no"></label><label>Proof<input type="file" name="proof" required></label><button class="btn btn-primary">Submit proof</button></form><% } %></section></div><div class="detail-panels"><section class="panel"><h2>Payments</h2><% payments.forEach(p=>{ %><div class="note"><strong>₱<%= Number(p.amount).toLocaleString() %> — <%= p.status %></strong><p><%= p.method %> • <%= p.reference_no||'No reference' %></p></div><% }) %><% if(!payments.length){ %><p class="muted">No payment records.</p><% } %></section><section class="panel"><h2>Damage charges</h2><% damages.forEach(d=>{ %><div class="note"><strong>₱<%= Number(d.amount).toLocaleString() %> — <%= d.description %></strong><p><%= d.remarks %></p></div><% }) %><% if(!damages.length){ %><p class="muted">No damage charges.</p><% } %></section></div><% if(booking.booking_status==='Completed' && !review){ %><section class="panel"><h2>Leave a review</h2><form method="post" action="/customer/bookings/<%= booking.id %>/review" class="form-stack"><label>Rating<select name="rating" required><option value="5">5 - Excellent</option><option value="4">4 - Very good</option><option value="3">3 - Good</option><option value="2">2 - Fair</option><option value="1">1 - Poor</option></select></label><label>Comment<textarea name="comment"></textarea></label><button class="btn btn-primary">Submit review</button></form></section><% } %></div></section><section class="section"><div class="container"><%- include('../partials/pickup-location') %></div></section><%- include('../partials/booking-receipt') %><%- include('../partials/footer') %>
