<%- include('../partials/header') %><section class="auth-section"><div class="auth-card"><a class="auth-back" href="/">← Back to RideRent</a><span class="eyebrow">Your next trip starts here</span><h1>Welcome back.</h1><p class="muted">Sign in to manage your rides and reservations.</p><form method="post" action="/login" class="form-stack"><label>Email or mobile number<input type="text" name="identifier" autocomplete="username" placeholder="you@email.com or 09xxxxxxxxx" required></label><label>Password<input type="password" name="password" autocomplete="current-password" placeholder="Enter your password" required></label><div class="row-between"><span class="muted">Ready when you are.</span><a href="/forgot-password">Forgot password?</a></div><button class="btn btn-primary">Sign in <span aria-hidden="true">↗</span></button></form><p class="auth-bottom">New to RideRent? <a href="/register">Create an account</a></p></div></section><%- include('../partials/footer') %>