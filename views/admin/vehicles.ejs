<%- include('../partials/header') %><section class="dashboard-shell"><div class="container"><div class="dash-head"><div><span class="eyebrow">Fleet</span><h1>Vehicle Management</h1></div><a class="btn btn-primary" href="/admin/vehicles/new">Add vehicle</a></div><div class="table-wrap"><table><thead><tr><th>Vehicle</th><th>Type</th><th>Plate</th><th>Rate</th><th>Status</th><th>Actions</th></tr></thead><tbody><% vehicles.forEach(v=>{ %><tr><td><strong><%= v.brand %> <%= v.model %></strong><br><small><%= v.year %> • <%= v.color %></small></td><td><%= v.type %></td><td><%= v.plate_number %></td><td>₱<%= Number(v.daily_rate).toLocaleString() %>/day</td><td><span class="status"><%= v.status %></span></td><td><a href="/admin/vehicles/<%= v.id %>/edit">Edit</a> <form class="inline" method="post" action="/admin/vehicles/<%= v.id %>/delete" data-confirm="Delete or archive this vehicle?"><button class="link-danger" data-confirm="Delete or archive this vehicle?">Delete</button></form></td></tr><% }) %></tbody></table></div></div></section><%- include('../partials/footer') %>
