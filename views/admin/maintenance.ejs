<%- include('../partials/header') %><section class="dashboard-shell"><div class="container"><div class="dash-head"><div><span class="eyebrow">Fleet care</span><h1>Maintenance</h1></div></div><div class="detail-panels"><section class="panel"><h2>Add maintenance</h2><form method="post" class="form-stack"><label>Vehicle<select name="vehicle_id" required><% vehicles.forEach(v=>{ %><option value="<%= v.id %>"><%= v.brand %> <%= v.model %> — <%= v.plate_number %></option><% }) %></select></label><label>Type<input name="maintenance_type" placeholder="Oil change / Repair / Inspection" required></label><label>Description<textarea name="description"></textarea></label><label>Start date<input type="date" name="start_date" required></label><label>End date<input type="date" name="end_date"></label><label>Cost<input type="number" step="0.01" name="cost" value="0"></label><label>Status<select name="status"><option>Scheduled</option><option>In Progress</option><option>Completed</option><option>Cancelled</option></select></label><label>Notes<textarea name="notes"></textarea></label><button class="btn btn-primary">Save maintenance</button></form></section><section class="panel"><h2>Maintenance records</h2><% rows.forEach(m=>{ %><div class="maintenance-item"><strong><%= m.brand %> <%= m.model %> — <%= m.maintenance_type %></strong><p><%= m.start_date %> • ₱<%= Number(m.cost).toLocaleString() %> • <%= m.status %></p><div><% if(m.status!=='Completed'){ %><form class="inline" method="post" action="/admin/maintenance/<%= m.id %>/complete"><button class="btn btn-small">Complete</button></form><% } %><form class="inline" method="post" action="/admin/maintenance/<%= m.id %>/delete"><button class="link-danger">Delete</button></form></div></div><% }) %></section></div></div></section><%- include('../partials/footer') %>
