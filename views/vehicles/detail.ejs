<%- include('../partials/header') %><section class="section"><div class="container detail-grid"><div class="vehicle-gallery" data-gallery><% const photos=vehiclePhotos(vehicle);const gallery=photos.length?photos:[{src:vehicle.image,title:vehicle.brand+' '+vehicle.model}]; %><div class="gallery-stage"><img class="gallery-main" src="<%= gallery[0].src %>" alt="<%= vehicle.brand %> <%= vehicle.model %>"><div class="gallery-controls"><button type="button" data-prev aria-label="Previous photo">←</button><span data-gallery-count>1 / <%= gallery.length %></span><button type="button" data-next aria-label="Next photo">→</button></div></div><div class="gallery-thumbs"><% gallery.forEach((photo,i)=>{ %><button type="button" data-photo="<%= photo.src %>" data-alt="<%= vehicle.brand %> <%= vehicle.model %> — photo <%= i+1 %>" aria-label="View photo <%= i+1 %>" aria-pressed="<%= i===0 %>" class="<%= i===0?'active':'' %>"><img src="<%= photo.src %>" alt="" loading="lazy"></button><% }) %></div><p class="photo-note">Model reference photos. Actual rental unit, year, color and trim may differ.</p><details class="photo-credits"><summary>Photo credits</summary><% photos.filter(photo=>photo.source).forEach(photo=>{ %><p><a href="<%= photo.source %>" target="_blank" rel="noopener"><%= photo.title %></a> · <%= photo.author %> · <a href="<%= photo.licenseUrl||photo.source %>" target="_blank" rel="noopener"><%= photo.license %></a></p><% }) %></details></div><div><span class="badge"><%= vehicle.type %></span><h1><%= vehicle.brand %> <%= vehicle.model %></h1><p class="muted"><%= vehicle.description %></p><div class="spec-grid"><div><span>Daily rate</span><strong>₱<%= Number(vehicle.daily_rate).toLocaleString() %></strong></div><div><span>Status</span><strong><%= vehicle.status %></strong></div><div><span>Transmission</span><strong><%= vehicle.transmission %></strong></div><div><span>Fuel</span><strong><%= vehicle.fuel_type %></strong></div><div><span>Color</span><strong><%= vehicle.color %></strong></div><div><span>Plate</span><strong><%= vehicle.plate_number %></strong></div><% if(vehicle.type==='Motorcycle'){ %><div><span>Engine</span><strong><%= vehicle.engine_cc %> cc</strong></div><div><span>Helmet</span><strong><%= vehicle.helmet_included?'Included':'Not included' %></strong></div><% } else { %><div><span>Seats</span><strong><%= vehicle.seats %></strong></div><% } %></div><div class="actions"><% if(currentUser && currentUser.role==='customer'){ %><a class="btn btn-primary" href="/customer/book/<%= vehicle.id %>">Book now</a><% } else if(!currentUser){ %><a class="btn btn-primary" href="/login">Sign in to book</a><% } %></div></div></div></section><section class="section soft"><div class="container"><h2>Customer reviews</h2><div class="review-list"><% reviews.forEach(r=>{ %><article class="review" id="review-<%= r.id %>"><strong><%= (r.first_name||'').slice(0,1) + '*** ' + (r.last_name||'').slice(0,1) + '***' %></strong> <span class="review-stars" aria-label="<%= r.rating %> out of 5 stars"><%= '★'.repeat(r.rating) %></span><p><%= r.comment %></p><div class="review-actions"><% if(currentUser && currentUser.role==="customer"){ %><form method="post" action="/customer/reviews/<%= r.id %>/react"><input type="hidden" name="reaction" value="like"><button type="submit" class="btn btn-small <%= r.my_reaction==="like"?"selected":"" %>" aria-pressed="<%= r.my_reaction==="like" %>">👍 Like <%= r.like_count %></button></form><form method="post" action="/customer/reviews/<%= r.id %>/react"><input type="hidden" name="reaction" value="love"><button type="submit" class="btn btn-small <%= r.my_reaction==="love"?"selected":"" %>" aria-pressed="<%= r.my_reaction==="love" %>">❤️ Love <%= r.love_count %></button></form><% } else { %><span>👍 <%= r.like_count %> · ❤️ <%= r.love_count %></span><% if(!currentUser){ %><a href="/login">Sign in to react</a><% } %><% } %><a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(shareBase+'?review='+r.id+'#review-'+r.id) %>" target="_blank" rel="noopener noreferrer">Share on Facebook</a></div></article><% }) %><% if(!reviews.length){ %><p class="muted">No reviews yet.</p><% } %></div></div></section><% if(vehicle.type==='Motorcycle'&&(!vehicle.or_path||!vehicle.cr_path||!vehicle.registration_expiry||vehicle.registration_expiry<new Date().toISOString().slice(0,10))){ %><div class="container alert warning">Registration documents need updating. Booking is disabled until the shop updates this motorcycle’s OR/CR.</div><% } %><section class="section"><div class="container"><%- include('../partials/pickup-location') %></div></section><style>.review-stars{color:#f4b400;font-size:1.2rem;letter-spacing:2px}.review-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:12px}.review-actions form{display:inline}.review-actions .selected{background:#ffe8a3;color:#112d4e}.review-actions a{font-size:.85rem;font-weight:700}</style><%- include('../partials/footer') %>
