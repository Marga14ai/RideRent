<%- include('../partials/header') %><section class="section"><div class="container booking-layout"><div class="booking-summary"><img src="<%= vehicle.image %>"><span class="badge"><%= vehicle.type %></span><h2><%= vehicle.brand %> <%= vehicle.model %></h2><p><%= vehicle.description %></p><strong class="price">₱<%= Number(vehicle.daily_rate).toLocaleString() %>/day</strong></div><div class="panel"><h1>Reserve this unit</h1><p class="muted">Availability is checked automatically before confirmation.</p><form method="post" enctype="multipart/form-data" class="form-grid"><label>Pickup date<input type="date" name="start_date" required></label><label>Return date<input type="date" name="end_date" required></label><label>Pickup time<input type="time" name="pickup_time" value="09:00" required></label><label>Return time<input type="time" name="return_time" value="18:00" required></label><label class="full">How would you like to pay?<select name="payment_choice" id="paymentChoice" required><option value="online_down">Online transfer — 50% downpayment</option><option value="online_full">Online transfer — full payment</option><option value="location">Pay at pickup location</option></select></label><label class="online-only">Payment reference<input name="payment_reference" placeholder="Reference number"></label><label class="online-only">Proof of payment<input type="file" name="proof" accept="image/*,.pdf"></label><label class="full check"><input type="checkbox" name="terms" value="1" required> I agree to the rental terms and conditions.</label><div class="full"><button class="btn btn-primary">Confirm booking</button></div></form><div class="terms-box"><strong>Important rules</strong><p>Booking is completed online. Online transfer proofs are reviewed by the shop. Pay-at-pickup payments are recorded by staff when received. Unpaid online-transfer reservations expire after <%= config.reservationExpiryHours %> hours. Cancellation is allowed before the rental starts. Late fee is ₱<%= config.latePenaltyPerHour %> per hour.</p></div></div></div></section><section class="section"><div class="container"><%- include('../partials/pickup-location') %></div></section><%- include('../partials/footer') %>
