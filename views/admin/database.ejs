<%- include('../partials/header') %><section class="section"><div class="container"><h1>Database explorer</h1><p>Read-only tables, columns, keys and relationships. Sensitive credentials and document paths are protected. Tables show 50 records per page.</p><div class="admin-shortcuts"><% tables.forEach(t=>{ %><a href="?table=<%= t.name %>"><%= t.name %> (<%= t.count %>)</a><% }) %></div><h2>Entity relationship diagram</h2><div id="erd" class="erd-wrap"></div><h2>Table structure and relationships</h2><% tables.forEach(t=>{ %><details class="panel"><summary><%= t.name %> — <%= t.count %> records</summary><div class="table-wrap"><table><thead><tr><th>Column</th><th>Type</th><th>Primary key</th><th>Required</th><th>Default</th></tr></thead><tbody><% t.columns.forEach(c=>{ %><tr><td><%= c.name %></td><td><%= c.type %></td><td><%= c.pk?'Yes':'—' %></td><td><%= c.notnull||c.pk?'Yes':'No' %></td><td><%= c.dflt_value||'—' %></td></tr><% }) %></tbody></table></div><% t.foreignKeys.forEach(f=>{ %><p><%= t.name %>.<%= f.from %> → <%= f.table %>.<%= f.to %></p><% }) %><pre><%= t.sql %></pre></details><% }) %><% if(selected){ %><h2><%= selected.name %> records</h2><div class="table-wrap"><table><thead><tr><% selected.columns.forEach(c=>{ %><th><%= c.name %></th><% }) %></tr></thead><tbody><% rows.forEach(r=>{ %><tr><% selected.columns.forEach(c=>{ %><td><%= r[c.name]??'—' %></td><% }) %></tr><% }) %></tbody></table></div><div class="actions"><% if(page>1){ %><a class="btn btn-light" href="?table=<%= selected.name %>&page=<%= page-1 %>">Previous</a><% } %><span>Page <%= page %> / <%= Math.max(1,Math.ceil(selected.count/50)) %></span><% if(page*50<selected.count){ %><a class="btn btn-light" href="?table=<%= selected.name %>&page=<%= page+1 %>">Next</a><% } %></div><% } %></div></section><script id="erd-data" type="application/json"><%- JSON.stringify(tables.map(t=>({name:t.name,columns:t.columns,foreignKeys:t.foreignKeys}))).replace(/</g,'\u003c') %></script><script src="/js/erd.js"></script><%- include('../partials/footer') %>