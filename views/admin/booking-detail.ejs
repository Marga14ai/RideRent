<%- include('../partials/header') %><section class="section"><div class="container"><div class="dash-head"><div><span class="eyebrow">Manage booking</span><h1><%= booking.booking_code %></h1></div><button class="btn btn-light" onclick="window.print()">Print</button></div><div class="detail-panels"><section class="panel"><h2>Rental details</h2><p><strong>Customer:</strong> <%= booking.first_name %> <%= booking.last_name %></p><p><strong>Email:</strong> <%= booking.email %></p><p><strong>Contact:</strong> <%= booking.contact %></p><p><strong>Vehicle:</strong> <%= booking.brand %> <%= booking.model %> (<%= booking.plate_number %>)</p><p><strong>Dates:</strong> <%= booking.start_date %> <%= booking.pickup_time %> → <%= booking.end_date %> <%= booking.return_time %></p><p><strong>Booking status:</strong> <%= booking.booking_status %></p><p><strong>Payment:</strong> <%= booking.payment_status %> / <%= booking.payment_option %></p><p><strong>Total:</strong> ₱<%= Number(booking.total_amount).toLocaleString() %> | <strong>Paid:</strong> ₱<%= Number(booking.amount_paid).toLocaleString() %></p><p><strong>Late:</strong> <%= booking.late_hours %> hr(s) / ₱<%= Number(booking.late_penalty).toLocaleString() %></p><% if(booking.refund_status!=='None'){ %><p><strong>Refund:</strong> <%= booking.refund_status %></p><% } %><div class="actions"><% if(booking.booking_status==='Confirmed'){ %><form class="inline" method="post" action="/admin/bookings/<%= booking.id %>/pickup"><button class="btn btn-primary">Confirm pickup</button></form><% } %><% if(booking.booking_status==='Ongoing'){ %><form class="inline" method="post" action="/admin/bookings/<%= booking.id %>/return" data-confirm="Confirm the vehicle return now?"><button class="btn btn-primary" data-confirm="Confirm the vehicle return now?">Confirm return</button></form><% } %><% if(booking.refund_status==='Refund Due'){ %><form class="inline" method="post" action="/admin/bookings/<%= booking.id %>/refund"><button class="btn btn-light">Mark refund completed</button></form><% } %></div></section><section class="panel"><h2>Add damage charge</h2><form method="post" action="/admin/bookings/<%= booking.id %>/damage" enctype="multipart/form-data" class="form-stack"><label>Description<input name="description" required></label><label>Amount<input type="number" step="0.01" name="amount" required></label><label>Photo<input type="file" name="photo" accept="image/*,.pdf"></label><label>Remarks<textarea name="remarks"></textarea></label><button class="btn btn-danger">Add charge</button></form></section></div><div class="detail-panels"><section class="panel"><h2>Payment verification</h2><% if(booking.payment_method==="Pay at Location" && booking.booking_status!=="Cancelled" && Number(booking.amount_paid)<Number(booking.total_amount)+Number(booking.late_penalty)){ %><form method="post" action="/admin/bookings/<%= booking.id %>/location-payment" class="form-stack"><p>Record payment only after receiving it at the shop. Remaining balance: ₱<%= Math.max(0,Number(booking.total_amount)+Number(booking.late_penalty)-Number(booking.amount_paid)).toLocaleString() %></p><label>Amount received<input type="number" name="amount" min="0.01" max="<%= Math.max(0,Number(booking.total_amount)+Number(booking.late_penalty)-Number(booking.amount_paid)).toFixed(2) %>" step="0.01" required></label><button type="button" class="btn btn-primary" onclick="this.nextElementSibling.hidden=false;this.hidden=true">Record payment received</button><div hidden><p>Confirm that you received this payment at the shop.</p><button type="submit" class="btn btn-primary">Yes, record payment</button> <button type="button" class="btn btn-light" onclick="this.parentElement.hidden=true;this.parentElement.previousElementSibling.hidden=false">Cancel</button></div></form><hr><% } %><% payments.forEach(p=>{ %><div class="payment-item"><div><strong>₱<%= Number(p.amount).toLocaleString() %> — <%= p.status %></strong><p>Ref: <%= p.reference_no||'—' %></p><% if(p.proof_path){ %><a href="<%= p.proof_path %>" target="_blank">Open proof</a><% } %></div><% if(p.status==='Pending Verification'){ %><div><form class="inline" method="post" action="/admin/payments/<%= p.id %>/verify"><button class="btn btn-small">Verify</button></form><form class="inline" method="post" action="/admin/payments/<%= p.id %>/reject"><button class="btn btn-small btn-danger">Reject</button></form></div><% } %></div><% }) %><% if(!payments.length){ %><p class="muted">No payment proof submitted.</p><% } %></section><section class="panel"><h2>Damage charges</h2><% damages.forEach(d=>{ %><div class="note"><strong>₱<%= Number(d.amount).toLocaleString() %> — <%= d.description %></strong><p><%= d.remarks %></p><% if(d.photo_path){ %><a href="<%= d.photo_path %>" target="_blank">View photo</a><% } %></div><% }) %><% if(!damages.length){ %><p class="muted">No damage charges.</p><% } %></section></div></div></section><style>[hidden]{display:none!important}</style><%- include('../partials/footer') %>
