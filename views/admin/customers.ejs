<%- include('../partials/header') %><section class="dashboard-shell"><div class="container"><div class="dash-head"><div><span class="eyebrow">Users</span><h1>Customer Management</h1></div></div><div class="table-wrap"><table><thead><tr><th>Customer</th><th>Contact</th><th>Documents</th><th>Bookings</th><th>Status</th><th>Action</th></tr></thead><tbody><% customers.forEach(c=>{ %><tr><td><strong><%= c.first_name %> <%= c.last_name %></strong><br><small><%= c.email %></small></td><td><%= c.contact||'—' %></td><td><% if(c.valid_id_path){ %><a target="_blank" href="<%= c.valid_id_path %>">ID</a><% } %> <% if(c.license_path){ %>• <a target="_blank" href="<%= c.license_path %>">License</a><% } %></td><td><%= c.booking_count %></td><td><span class="status"><%= c.is_active?'Active':'Inactive' %></span></td><td><form method="post" action="/admin/customers/<%= c.id %>/toggle"><button class="btn btn-small <%= c.is_active?'btn-danger':'' %>"><%= c.is_active?'Deactivate':'Activate' %></button></form></td></tr><% }) %></tbody></table></div></div></section><%- include('../partials/footer') %>
