<%- include('../partials/header') %><section class="dashboard-shell"><div class="container"><div class="print-header"><h1><%= config.siteName %></h1><p><%= config.location %> | <%= config.contactNumber %> | <%= config.contactEmail %></p><h2>Rental and Collection Report</h2><p>Period: <%= from||'Beginning' %> to <%= to||'Present' %> | Generated: <%= new Date().toLocaleString('en-PH',{timeZone:'Asia/Manila'}) %> (PHT)</p></div><div class="print-footer"><%= config.siteName %> · Prepared by <%= currentUser.first_name %> <%= currentUser.last_name %> · Internal rental report</div><div class="dash-head"><div><span class="eyebrow">Analytics</span><h1>Reports</h1></div><button class="btn btn-light" onclick="window.print()">Print report</button></div><form class="filter-bar no-print" method="get"><label>From<input type="date" name="from" value="<%= from %>"></label><label>To<input type="date" name="to" value="<%= to %>"></label><button class="btn btn-primary">Apply</button></form><div class="stat-grid"><div class="stat-card"><span>Bookings</span><strong><%= summary.bookings %></strong></div><div class="stat-card"><span>Booked value</span><strong>₱<%= Number(summary.booked_value).toLocaleString() %></strong></div><div class="stat-card"><span>Collected</span><strong>₱<%= Number(summary.collected).toLocaleString() %></strong></div><div class="stat-card"><span>Late fees</span><strong>₱<%= Number(summary.late_fees).toLocaleString() %></strong></div><div class="stat-card"><span>Maintenance cost</span><strong>₱<%= Number(maint).toLocaleString() %></strong></div></div><div class="detail-panels"><section class="panel"><h2>Most rented vehicles</h2><% popular.forEach(p=>{ %><div class="row-between"><span><%= p.vehicle %></span><strong><%= p.rentals %> rental(s)</strong></div><% }) %></section><section class="panel"><h2>Report notes</h2><p>This report summarizes booking value, actual verified collections, late penalties, and completed maintenance expenses.</p></section></div><div class="table-wrap"><table><thead><tr><th>Booking</th><th>Customer</th><th>Vehicle</th><th>Created</th><th>Total</th><th>Paid</th><th>Status</th></tr></thead><tbody><% rows.forEach(b=>{ %><tr><td><%= b.booking_code %></td><td><%= b.first_name %> <%= b.last_name %></td><td><%= b.brand %> <%= b.model %></td><td><%= b.created_at %></td><td>₱<%= Number(b.total_amount).toLocaleString() %></td><td>₱<%= Number(b.amount_paid).toLocaleString() %></td><td><%= b.booking_status %></td></tr><% }) %></tbody></table></div></div></section><%- include('../partials/footer') %>
