<%- include('../partials/header') %><section class="dashboard-shell"><div class="container"><div class="dash-head"><div><span class="eyebrow">Updates</span><h1><%= title %></h1></div></div><section class="panel"><% items.forEach(n=>{ %><div class="note"><strong><%= n.title %></strong><p><%= n.message %></p><small><%= n.created_at %></small></div><% }) %><% if(!items.length){ %><div class="empty">No notifications.</div><% } %></section></div></section><%- include('../partials/footer') %>
