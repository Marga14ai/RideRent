<%- include('../partials/header') %><section class="auth-section"><div class="auth-card wide"><a class="auth-back" href="/login">← Back to sign in</a><span class="eyebrow">A little about you</span><h1>Let's get you moving.</h1><p class="muted">Create your account and find your next ride.</p><form method="post" action="/register" enctype="multipart/form-data" class="form-grid"><label>First name<input name="first_name" autocomplete="given-name" required></label><label>Last name<input name="last_name" autocomplete="family-name" required></label><label>Email<input type="email" name="email" autocomplete="email" required></label><label>Mobile number<input type="tel" name="contact" autocomplete="tel" required placeholder="09xxxxxxxxx"></label><label class="full">Address<input name="address" autocomplete="street-address"></label><fieldset class="full birthday-field"><legend>Birthday</legend><div class="birthday-inputs"><label><span class="sr-only">Birth month</span><select id="birth-month" autocomplete="bday-month" required><option value="">Month</option><% ['January','February','March','April','May','June','July','August','September','October','November','December'].forEach((m,i)=>{ %><option value="<%= i+1 %>"><%= m %></option><% }) %></select></label><label><span class="sr-only">Birth day</span><select id="birth-day" autocomplete="bday-day" required><option value="">Day</option><% for(let d=1;d<=31;d++){ %><option value="<%= d %>"><%= d %></option><% } %></select></label><label><span class="sr-only">Birth year</span><select id="birth-year" autocomplete="bday-year" required><option value="">Year</option><% for(let y=new Date().getFullYear();y>=1900;y--){ %><option value="<%= y %>"><%= y %></option><% } %></select></label></div><input type="hidden" name="birth_date" id="birth-date"><small class="muted">Select your real birthday. Minimum age: <%= config.minimumAge %>.</small></fieldset><label>Password<input type="password" name="password" autocomplete="new-password" minlength="8" required placeholder="At least 8 characters"></label><label>Confirm password<input type="password" name="confirm_password" autocomplete="new-password" minlength="8" required></label><label class="full upload-license">Driver's license<input type="file" name="license" accept=".jpg,.jpeg,.png,.webp,.pdf" required><small class="muted">JPG, PNG, WEBP or PDF · Maximum 5 MB</small></label><div class="full"><button class="btn btn-primary">Create account <span aria-hidden="true">↗</span></button></div></form><p class="auth-bottom">Already have an account? <a href="/login">Sign in</a></p></div></section><%- include('../partials/footer') %>