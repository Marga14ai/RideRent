<%- include('../partials/header') %><section class="dashboard-shell"><div class="container"><div class="dash-head"><div><span class="eyebrow">Customer dashboard</span><h1>Hello, <%= currentUser.first_name %></h1></div><a class="btn btn-primary" href="/vehicles">Book a ride</a></div><div class="stat-grid"><div class="stat-card"><span>Total bookings</span><strong><%= stats.total %></strong></div><div class="stat-card"><span>Active rentals</span><strong><%= stats.active %></strong></div><div class="stat-card"><span>Estimated balance</span><strong>₱<%= Number(stats.due).toLocaleString() %></strong></div></div><div class="dash-grid"><section class="panel"><div class="panel-head"><h2>Upcoming & active</h2><a href="/customer/bookings">View all</a></div><% active.forEach(b=>{ %><a class="booking-row" href="/customer/bookings/<%= b.id %>"><img src="<%= b.image %>"><div><strong><%= b.brand %> <%= b.model %></strong><small><%= b.booking_code %> • <%= b.start_date %> to <%= b.end_date %></small></div><span class="status"><%= b.booking_status %></span></a><% }) %><% if(!active.length){ %><div class="empty">No active bookings.</div><% } %></section><section class="panel"><div class="panel-head"><h2>Notifications</h2><a href="/customer/notifications">View all</a></div><% notes.forEach(n=>{ %><div class="note"><strong><%= n.title %></strong><p><%= n.message %></p></div><% }) %><% if(!notes.length){ %><div class="empty">No notifications yet.</div><% } %></section></div></div></section><%- include('../partials/footer') %>
