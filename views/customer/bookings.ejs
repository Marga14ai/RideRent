<%- include('../partials/header') %><section class="dashboard-shell"><div class="container"><div class="dash-head"><div><span class="eyebrow">Rental history</span><h1>My Bookings</h1></div><a class="btn btn-primary" href="/vehicles">New booking</a></div><div class="table-wrap"><table><thead><tr><th>Booking</th><th>Vehicle</th><th>Dates</th><th>Total</th><th>Payment</th><th>Status</th><th></th></tr></thead><tbody><% bookings.forEach(b=>{ %><tr><td><strong><%= b.booking_code %></strong></td><td><%= b.brand %> <%= b.model %></td><td><%= b.start_date %> → <%= b.end_date %></td><td>₱<%= Number(b.total_amount+b.late_penalty).toLocaleString() %></td><td><span class="status"><%= b.payment_status %></span></td><td><span class="status"><%= b.booking_status %></span></td><td><a href="/customer/bookings/<%= b.id %>">View</a></td></tr><% }) %></tbody></table></div><% if(!bookings.length){ %><div class="empty">You have no bookings yet.</div><% } %></div></section><%- include('../partials/footer') %>
