<%- include('../partials/header') %><section class="section"><div class="container narrow"><div class="panel"><span class="eyebrow">Account</span><h1>My Profile</h1><form method="post" class="form-grid"><label>First name<input name="first_name" value="<%= user.first_name %>" required></label><label>Last name<input name="last_name" value="<%= user.last_name %>" required></label><label>Email<input value="<%= user.email %>" disabled></label><label>Contact<input name="contact" value="<%= user.contact||'' %>"></label><label class="full">Address<input name="address" value="<%= user.address||'' %>"></label><div class="full"><button class="btn btn-primary">Save changes</button></div></form><p class="muted">Uploaded ID: <%= user.valid_id_path?'Available':'Missing' %> • Driver's license: <%= user.license_path?'Available':'Missing' %></p></div></div></section><%- include('../partials/footer') %>
