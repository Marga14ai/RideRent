<%- include('../partials/header') %><section class="dashboard-shell"><div class="container"><div class="dash-head"><div><span class="eyebrow">Administration</span><h1>RideRent Dashboard</h1></div><a class="btn btn-primary" href="/admin/vehicles/new">Add vehicle</a></div><div class="stat-grid six"><div class="stat-card"><span>Total vehicles</span><strong><%= stats.vehicles %></strong></div><div class="stat-card"><span>Available</span><strong><%= stats.available %></strong></div><div class="stat-card"><span>Rented</span><strong><%= stats.rented %></strong></div><div class="stat-card"><span>Customers</span><strong><%= stats.customers %></strong></div><div class="stat-card"><span>Pending payments</span><strong><%= stats.pendingPayments %></strong></div><div class="stat-card"><span>Collected revenue</span><strong>₱<%= Number(stats.revenue).toLocaleString() %></strong></div></div><div class="admin-shortcuts"><a href="/admin/visitors">Visitor Statistics</a><a href="/admin/documents">OR/CR & Renewals</a><a href="/admin/database">Database & ERD</a><a href="/admin/settings">Shop Settings</a><a href="/admin/bookings">Booking Management</a><a href="/admin/customers">Customer Management</a><a href="/admin/maintenance">Maintenance</a><a href="/admin/reports">Reports</a></div><div class="dash-grid"><section class="panel"><div class="panel-head"><h2>Recent bookings</h2><a href="/admin/bookings">View all</a></div><% recent.forEach(b=>{ %><a class="booking-row" href="/admin/bookings/<%= b.id %>"><div><strong><%= b.booking_code %> — <%= b.brand %> <%= b.model %></strong><small><%= b.first_name %> <%= b.last_name %> • <%= b.start_date %></small></div><span class="status"><%= b.booking_status %></span></a><% }) %></section><section class="panel"><h2>Bookings by month</h2><% const max = Math.max(1,...monthly.map(x=>x.count)); monthly.forEach(m=>{ %><div class="bar-row"><span><%= m.month %></span><div class="bar-track"><i style="width:<%= Math.round(m.count/max*100) %>%"></i></div><strong><%= m.count %></strong></div><% }) %></section></div></div></section><%- include('../partials/footer') %>
