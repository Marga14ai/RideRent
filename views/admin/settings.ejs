<%- include('../partials/header') %><section class="section"><div class="container narrow panel"><h1>Shop settings</h1><p>Enter the actual shop address and pin its exact location. These details appear on Contact and printed reports.</p><form method="post" class="form-grid"><% for(const [key,label] of Object.entries({siteName:'Company name',location:'Shop address',contactEmail:'Email',contactNumber:'Phone',openingHours:'Opening hours',latitude:'Latitude',longitude:'Longitude'})){ %><label><%= label %><input name="<%= key %>" id="setting-<%= key %>" value="<%= config[key]||'' %>" <%= ['siteName','location','latitude','longitude'].includes(key)?'required':'' %>></label><% } %><div class="full"><button type="button" class="btn btn-light" id="pin-current">Use my location as shop pin</button><p id="pin-message" role="status"></p><div id="settings-map" class="shop-map"></div><p>Click the map to set the pin. You may also paste coordinates.</p></div><button class="btn btn-primary">Save settings</button></form></div></section><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"><script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script src="/js/settings-map.js"></script><%- include('../partials/footer') %>