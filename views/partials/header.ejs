<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="csrf-token" content="<%= csrfToken %>"><title><%= title %> | RideRent</title><% if(typeof shareReview!=="undefined" && shareReview){ %><meta property="og:title" content="<%= shareReview.brand %> <%= shareReview.model %> customer review"><meta property="og:description" content="<%= shareReview.rating %>/5 stars · <%= shareReview.comment %>"><meta property="og:url" content="<%= shareBase %>?review=<%= encodeURIComponent(shareReview.id||"") %>"><% } %><link rel="stylesheet" href="/css/style.css"><script>try{document.documentElement.dataset.theme=localStorage.getItem('riderent-theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');}catch(e){}</script></head><body>
<header class="site-header"><div class="container nav-wrap"><a class="brand" href="/"><span>Ride</span>Rent</a><button type="button" class="theme-icon" id="theme-toggle" aria-label="Switch color theme"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"/></svg></button><button class="nav-toggle" aria-label="Toggle navigation" onclick="document.querySelector('.nav-links').classList.toggle('open')">☰</button><nav class="nav-links">
<a href="/">Home</a><a href="/vehicles">Vehicles</a><a href="/about">About</a><a href="/contact">Contact</a>
<% if (!currentUser) { %><a href="/login">Login</a><a class="btn btn-primary" href="/register">Register</a><% } else if (currentUser.role==='admin') { %><a href="/admin">Dashboard</a><a href="/admin/vehicles">Manage Vehicles</a><a href="/admin/bookings">Bookings</a><a href="/admin/database">Database</a><a href="/admin/notifications">Notifications (<%= notificationCount %>)</a><form method="post" action="/logout"><button class="link-btn">Logout</button></form><% } else { %><a href="/customer">Dashboard</a><a href="/customer/bookings">My Bookings</a><a href="/customer/notifications">Notifications (<%= notificationCount %>)</a><a href="/customer/profile">Profile</a><form method="post" action="/logout"><button class="link-btn">Logout</button></form><% } %>
</nav></div></header><main>
<% if (flash) { %><div id="app-flash" class="alert <%= flash.type %>" data-type="<%= flash.type %>" data-message="<%= flash.message %>" hidden></div><% } %>
