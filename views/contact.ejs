<%- include('partials/header') %><section class="section"><div class="container"><span class="eyebrow">Find us</span><h1><%= config.siteName %></h1><div class="info-cards"><div class="info-card"><h2>Shop</h2><p><%= config.location %></p></div><div class="info-card"><h2>Contact</h2><p><%= config.contactNumber %></p><p><%= config.contactEmail %></p></div><div class="info-card"><h2>Hours</h2><p><%= config.openingHours %></p></div></div><% if(config.latitude&&config.longitude){ %><div id="shop-map" class="shop-map" data-lat="<%= config.latitude %>" data-lng="<%= config.longitude %>"></div><button class="btn btn-primary" id="get-directions">Show distance from my location</button> <a class="btn btn-light" target="_blank" rel="noopener" href="https://www.waze.com/ul?ll=<%= config.latitude %>%2C<%= config.longitude %>&navigate=yes">Open Waze directions</a><p id="route-status" role="status">Allow location access to show your route, distance, and estimated travel time.</p><p class="muted">Road distance and travel time are estimates without live traffic. Your location is used only in this browser to request a route.</p><% }else{ %><div class="terms-box">The exact shop pin has not been configured yet. Contact the shop for directions.</div><% } %></div></section><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"><script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script src="/js/contact-map.js"></script><%- include('partials/footer') %>