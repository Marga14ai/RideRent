<%- include('../partials/header') %><section class="page-hero"><div class="container"><span class="eyebrow">RideRent fleet</span><h1>Find your ride</h1><p>Filter by vehicle type, transmission, or price.</p></div></section><section class="section"><div class="container"><form class="filter-bar" method="get"><input name="q" placeholder="Search brand or model" value="<%= filters.q||'' %>"><select name="type"><option value="">All types</option><option <%= filters.type==='Car'?'selected':'' %>>Car</option><option <%= filters.type==='Motorcycle'?'selected':'' %>>Motorcycle</option></select><select name="transmission"><option value="">Any transmission</option><option <%= filters.transmission==='Automatic'?'selected':'' %>>Automatic</option><option <%= filters.transmission==='Manual'?'selected':'' %>>Manual</option></select><select name="sort"><option value="">Newest</option><option value="price_asc" <%= filters.sort==='price_asc'?'selected':'' %>>Price low-high</option><option value="price_desc" <%= filters.sort==='price_desc'?'selected':'' %>>Price high-low</option><option value="rating" <%= filters.sort==='rating'?'selected':'' %>>Rating</option></select><button class="btn btn-primary">Filter</button></form><div class="vehicle-grid"><% vehicles.forEach(v=>{ %><article class="vehicle-card"><a class="vehicle-image-link" href="/vehicles/<%= v.id %>"><img src="<%= v.image %>" alt="<%= v.brand %> <%= v.model %> <%= v.type %> model reference" loading="lazy"><span class="image-type"><%= v.type %></span></a><div class="card-body"><div class="row-between"><small class="muted"><%= v.transmission %> · <%= v.seats||2 %> seats</small><span class="status"><%= v.status %></span></div><h3><a href="/vehicles/<%= v.id %>"><%= v.brand %> <%= v.model %></a></h3><p><%= v.year %> · <%= v.fuel_type %> · ★ <%= Number(v.avg_rating).toFixed(1) %> (<%= v.review_count %>)</p><div class="card-price-row"><div><strong>₱<%= Number(v.daily_rate).toLocaleString() %></strong><small> / day</small></div><a class="round-link" href="/vehicles/<%= v.id %>" aria-label="View <%= v.brand %> <%= v.model %>">↗</a></div></div></article><% }) %></div><% if(!vehicles.length){ %><div class="empty">No vehicles match your filter.</div><% } %></div></section><%- include('../partials/footer') %>
